<UserControl x:Class="HalconWpf.Views.CameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="320">
    <DockPanel>
        <!-- 标题栏：标题 + 连接状态 -->
        <Border DockPanel.Dock="Top" Background="#FFF2F2F2" Padding="6,4"
                BorderBrush="#FFD8D8D8" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="相机功能" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding CameraStatus}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Foreground="#FF666666"/>
            </Grid>
        </Border>
        <!-- 按钮列表：纵向等宽排列 -->
        <Border DockPanel.Dock="Top" Background="#FFFAFAFA" Padding="8,8"
                BorderBrush="#FFE4E4E4" BorderThickness="0,0,0,1">
            <StackPanel>
                <Button Content="打开相机" Command="{Binding OpenCameraCommand}"
                        HorizontalAlignment="Stretch" Padding="0,6" Margin="0,0,0,6"/>
                <Button Content="关闭相机" Command="{Binding DisconnectCameraCommand}"
                        HorizontalAlignment="Stretch" Padding="0,6" Margin="0,0,0,6"/>
                <Button Content="开始采集" Command="{Binding StartCollectCommand}"
                        HorizontalAlignment="Stretch" Padding="0,6" Margin="0,0,0,6"/>
                <Button Content="停止采集" Command="{Binding StopCollectCommand}"
                        HorizontalAlignment="Stretch" Padding="0,6"/>
            </StackPanel>
        </Border>
        <Border BorderBrush="#FFBDBDBD" BorderThickness="1" Margin="4,2,4,4">
            <TextBlock Text="采集画面显示在 Halcon 窗口"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#FF9E9E9E"/>
        </Border>
    </DockPanel>
</UserControl>
