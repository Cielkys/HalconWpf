<UserControl x:Class="HalconWpf.Views.OutputParamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:HalconWpf.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="260">
    <!-- 左侧面板：顶部导航切换"流程 / 参数"，继承主 DataContext -->
    <TabControl>
        <TabItem Header="流程">
            <views:FlowView DataContext="{Binding Flow}"/>
        </TabItem>
        <TabItem Header="参数">
            <ContentControl DataContext="{Binding OutputParams}">
                <DockPanel Margin="4">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="清空" Padding="8,2"
                                Command="{Binding ClearCommand}" ToolTip="清空输出参数"/>
                        <TextBlock Text="输出参数" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Rows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="参数" Binding="{Binding Element}" Width="110"/>
                            <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </ContentControl>
        </TabItem>
    </TabControl>
</UserControl>
